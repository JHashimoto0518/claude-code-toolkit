{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Edit(/.git/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/hooks/**)",
      "Edit(/plugins/*/hooks/**)",
      "Edit(/plugins/*/.claude-plugin/**)",
      "Edit(/.devcontainer/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.config/git/**)",
      "Edit(~/.gitconfig)",
      "Edit(~/.bashrc)",
      "Edit(~/.profile)",
      "Edit(~/.local/share/claude/**)",
      "Bash(git push*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git clone*)",
      "Bash(git remote*)"
    ]
  },
  "sandbox": {
    "enabled": false
  }
}
